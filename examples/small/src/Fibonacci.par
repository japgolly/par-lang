module Fibonacci

import {
  @core/Nat
  @basic/Console
}

// An object with two methods, like an interface in OOP. `.next` produces an
// item and the sequence again, ready for more; `.close` ends it. The type says
// nothing about how the items are produced.
type Sequence<a> = iterative choice {
  .close* => !
  .next  => (a) self
}

// An implementation of that interface, created as a value. Its state is just
// the local variables `a` and `b`, which every `.next` updates.
dec Fibonacci : Sequence<Nat>
def Fibonacci =
  let (a) b = (0) 1
  in begin case {
    .close* => !
    .next =>
      let next = a + b in
      let (a) b = (b) next
      in (a) loop
  }

def Main: ! = do {
  let console = Console.Open
  let fib = Fibonacci

  Nat.Repeat(30).begin.case {
    .end! => {}
    .step remaining => {
      fib.next[n]
      console.print(`#{n}`)
      remaining.loop
    }
  }

  fib.close
  console.close
} in !
