module Additive

import @core/Test
import @core/Bool


def Not: [Bool] Bool = [x] x.case {
    .true! => .false!,
    .false! => .true!,
}

def TestCheckTrue: [Test] ! = [test] chan user {
    test.check("Hi", .true!)
    user!
}

def TestBoolNot: [Test] ! = [test] chan user {
    test.check("Hi", Not(.false!))
    user!
}
