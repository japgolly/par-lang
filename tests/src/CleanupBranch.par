module CleanupBranch

import {
  @core/Bool
  @core/Bytes
  @core/Map
  @core/Nat
  @core/String
  @core/Test
}

type Finalizer = choice {
  .finish* => !,
}

type Resource = choice {
  .release* => Finalizer,
}

type CleanupEvent = either {
  .done*!,
}

def HandleCleanupEventExpression: [CleanupEvent] ! = [event] event.case {
  .done*! => !,
}

def HandleCleanupEventCommand: [CleanupEvent] ! = [event] do {
  event.case {
    .done*! => {}
  }
} in !

def TestAutomaticCleanup: [Test] ! = [test] do {
  let resource = case {
    .release* => case {
      .finish* => do {
        test.check(
          "Automatic cleanup follows a non-close branch and disposes its result",
          .true!,
        )
      } in !
    }
  }
} in !

def TestAutomaticCleanupBeforeLoop: [Test] ! = [test] do {
  let resource = case {
    .release* => case {
      .finish* => do {
        test.check(
          "Automatic cleanup happens before entering a recursive loop",
          .true!,
        )
      } in !
    }
  }
} in Nat.Repeat(1).begin.case {
  .end! => !,
  .step repeat => repeat.loop,
}

def TestExplicitCleanupBranchCall: [Test] ! = [test] do {
  let resource: Resource = case {
    .release* => case {
      .finish* => do {
        test.check("A cleanup branch remains normally callable", .true!)
      } in !
    }
  }
  let finalizer = resource.release
  finalizer.finish
} in !

def TestExternalCleanupAlias: [Test] ! = [test] do {
  let resource: Finalizer = case {
    .finish* => do {
      test.check("Rust externals receive the synthesized cleanup branch", .true!)
    } in !
  }

  let map = Map.New(type Nat, type Finalizer)
  map.entry(0)[entry]
  entry.case {
    .none! => { map.put(resource) },
    .some previous => { map.put(resource) },
  }
} in !

def TestDroppingUnfinishedBuilders: [Test] ! = [test] do {
  let strings = String.Builder.add("unfinished")
  let bytes = Bytes.Builder.add("unfinished")
  test.check("Unfinished String and Bytes builders are dropped via `.build*`", .true!)
} in !

dec ShadowedFinalizer : [Test, String] Finalizer
def ShadowedFinalizer = [test, label] case {
  .finish* => do {
    test.check(
      `Receiving into an already bound name disposes the old value (${label})`,
      .true!,
    )
  } in !,
}

dec ShadowedFinalizers : [Test, String] (Finalizer, Finalizer) !
def ShadowedFinalizers = [test, label]
  (ShadowedFinalizer(test, `${label}1`), ShadowedFinalizer(test, `${label}2`))!

def TestCleanupShadowedReceive: [Test] ! = [test] do {
  ShadowedFinalizers(test, "a")[x, _]?
  ShadowedFinalizers(test, "b")[y, _]?
} in !
