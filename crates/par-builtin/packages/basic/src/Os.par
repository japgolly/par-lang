// Operating system interfaces for paths, files, directories, standard streams,
// and environment variables.
//
// Most operations return `Try<Os.Error, ...>`.
export module Os

import {
  @core/BoxMap
  @core/Bool
  @core/Bytes
  @core/List
  @core/Option
  @core/Try
  @core/String
}

export {
  // Error type for OS operations (a human-readable message).
  type Error  = String

  // A byte reader for OS I/O, with `Os.Error` as the error type.
  type Reader = Bytes.Reader<Error>

  // A byte writer for OS I/O, with `Os.Error` as the error type.
  type Writer = Bytes.Writer<Error>

  // A filesystem path value.
  //
  // - `.name` — get the file name component as bytes.
  // - `.absolute` — get the absolute path as bytes.
  // - `.parts` — get all path components as a list of byte sequences.
  // - `.parent` — get the parent path, or `.none!` if at root.
  // - `.append(part)` — return a path with one more path component.
  type Path = iterative@append recursive@parent box choice {
    .name => Bytes,
    .absolute => Bytes,
    .parts => List<Bytes>,

    .parent => Option<self@parent>,
    .append(Bytes) => self@append,
  }

  // Creates a `Path` from its byte representation.
  dec Path : [Bytes] Path

  // Tests whether a path exists. Returns `.false!` if that can't be determined,
  // e.g. due to missing permissions.
  dec Exists : [Path] Bool

  // Tests whether a path exists and is a file, following symlinks.
  dec IsFile : [Path] Bool

  // Tests whether a path exists and is a directory, following symlinks.
  dec IsDir : [Path] Bool

  // Standard input as a byte reader.
  dec Stdin : Reader

  // Standard output as a byte writer.
  dec Stdout : Writer

  // Standard error as a byte writer.
  dec Stderr : Writer

  // Opens a file for reading.
  dec OpenFile : [Path] Try<Error, Reader>

  // Creates or replaces a file for writing. Truncates if the file already exists.
  dec CreateOrReplaceFile : [Path] Try<Error, Writer>

  // Creates a new file for writing. Fails if the file already exists.
  dec CreateNewFile : [Path] Try<Error, Writer>

  // Opens an existing file for appending. Fails if the file does not exist.
  dec AppendToFile : [Path] Try<Error, Writer>

  // Opens or creates a file for appending.
  dec CreateOrAppendToFile : [Path] Try<Error, Writer>

  // Reads a whole file into memory.
  dec ReadFile : [Path] Try<Error, Bytes>

  // Writes bytes to a file, creating it or replacing its contents.
  dec WriteFile : [Path, Bytes] Try<Error, !>

  // Creates a directory and all necessary parent directories.
  dec CreateDir : [Path] Try<Error, !>

  // Removes a file.
  dec RemoveFile : [Path] Try<Error, !>

  // Removes an empty directory.
  dec RemoveDir : [Path] Try<Error, !>

  // Removes a directory together with everything inside it.
  dec RemoveDirAll : [Path] Try<Error, !>

  // Copies a file's contents to another path, replacing that file if it exists.
  dec CopyFile : [Path, Path] Try<Error, !>

  // Moves or renames a file.
  dec MoveFile : [Path, Path] Try<Error, !>

  // Moves or renames a directory.
  dec MoveDir : [Path, Path] Try<Error, !>

  // Lists the entries of a directory, returning a list of paths sorted by name.
  dec ListDir : [Path] Try<Error, List<Path>>

  // Recursively traverses a directory tree, returning a nested structure of files and
  // subdirectories sorted by name.
  //
  // - `.end!` — no more entries.
  // - `.file(path) rest` — a file, followed by more entries.
  // - `.dir(path, children) rest` — a subdirectory with its nested contents, followed by more entries.
  dec TraverseDir : [Path] Try<Error, recursive either {
    .end!,
    .file(Path) self,
    .dir(Path, self) self,
  }>

  // Read-only view of the process environment variables.
  dec Env : BoxMap.Readonly<Bytes, Bytes>
}

def Path = external

def Exists = external

def IsFile = external

def IsDir = external

def Stdin = external

def Stdout = external

def Stderr = external

def OpenFile = external

def CreateOrReplaceFile = external

def CreateNewFile = external

def AppendToFile = external

def CreateOrAppendToFile = external

def ReadFile = [path] catch e => .err e in do {
  let try reader = path->OpenFile
} in reader->Bytes.ReadAll

def WriteFile = [path, bytes] catch e => .err e in do {
  let try writer = path->CreateOrReplaceFile
  writer.write(bytes).try
  writer.close.try
} in .ok!

def CreateDir = external

def RemoveFile = external

def RemoveDir = external

def RemoveDirAll = external

def CopyFile = external

def MoveFile = external

def MoveDir = external

def ListDir = external

def TraverseDir = external

def Env = external
