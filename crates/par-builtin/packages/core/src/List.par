// Finite list types and list combinators.
//
// ```par
// let xs = *(1, 2, 3)
// xs->List.Map(box [n] n * 2)
// ```
export module List

import {
  Bool
  Map as CoreMap
  Nat
  Number
  Option
}

export {
  // A finite, ordered sequence of values.
  //
  // ```par
  // *(1, 2, 3)  // syntax sugar for .item(1) .item(2) .item(3) .end!
  // ```
  type List<a> = recursive either {
    .end!,
    .item(a) self,
  }

  // Incrementally constructs a list.
  type Builder<a> = iterative choice {
    .add(a) => self,
    .build* => List<a>,
  }

  // Creates a new list `Builder`.
  dec Builder : [type a] Builder<a>

  // Applies a mapping function to each element of a list.
  //
  // ```par
  // *(1, 2, 3)->List.Map(box [n] n * 2)
  // // = *(2, 4, 6)
  // ```
  dec Map : [<a> List<a>, <b> box [a] b] List<b>

  // Maps each element to a list, then concatenates the result.
  dec FlatMap : [<a> List<a>, <b> box [a] List<b>] List<b>

  // Maps each element to an optional value, keeping only the present results.
  dec FilterMap : [<a> List<a>, <b> box [a] Option<b>] List<b>

  // Keeps the elements for which the test function returns `.true!`.
  dec Filter : [<a: share> List<a>, box [a] Bool] List<a>

  // Splits a list into the elements for which the test function returns `.true!`,
  // and the rest. Both keep their original order.
  //
  // ```par
  // *(1, 2, 3, 4)->List.Partition(box [n] n > 2)
  // // = (*(3, 4)) *(1, 2)
  // ```
  dec Partition : [<a: share> List<a>, box [a] Bool] (List<a>) List<a>

  // Like `Partition`, but for linear elements: the test function returns the
  // element back along with the verdict.
  dec PartitionLinear : [<a> List<a>, box [a] (Bool) a] (List<a>) List<a>

  // Returns the first element for which the test function returns `.true!`.
  dec Find : [<a: share> List<a>, box [a] Bool] Option<a>

  // Returns `.true!` if the list contains an element equal to the given one.
  dec Contains : [<a: data> List<a>, a] Bool

  // Returns the number of elements for which the test function returns `.true!`.
  dec Count : [<a> List<a>, box [a] Bool] Nat

  // Applies a folding function repeatedly to the current result and each list
  // element, returning the final result.
  //
  // Expression syntax:
  //
  // ```par
  // 0->List.ForEach(*(1, 2, 3), box [sum, n] sum + n)
  // // = 6
  // ```
  //
  // Process syntax:
  //
  // ```par
  // let console = Console.Open
  // console->List.ForEach(Nat.Range(1, 10), box [c, i]
  //   c.print(`#{i}`)
  // )
  // console.close
  // ```
  dec ForEach : [<r> r, <a> List<a>, box [r, a] r] r

  // Returns the number of elements in a list.
  dec Length : [<a: drop> List<a>] Nat

  // Returns the first element, or `.none!` for an empty list.
  dec First : [<a: drop> List<a>] Option<a>

  // Returns the last element, or `.none!` for an empty list.
  dec Last : [<a: drop> List<a>] Option<a>

  // Flattens a list of lists into a single list.
  dec Concat : [<a> List<List<a>>] List<a>

  // Returns a list with the elements in reverse order.
  dec Reverse : [<a> List<a>] List<a>

  // Removes duplicate elements, keeping the first occurrence of each, in the original order.
  //
  // ```par
  // *(3, 1, 3, 2, 1)->List.Dedup  // = *(3, 1, 2)
  // ```
  dec Dedup : [<a: data> List<a>] List<a>

  // Yields all items from a source list onto a destination channel, consuming the source.
  dec Copy : [<a> dual List<a>, List<a>] dual List<a>

  // Pairs each element with its zero-based index.
  dec Enumerate : [<a> List<a>] List<(Nat) a>

  // Zips two lists into a list of pairs. Stops at the shorter list.
  dec Zip : [<a: drop> List<a>, <b: drop> List<b>] List<(a) b>

  // Splits a list of pairs into a pair of lists.
  dec Unzip : [<a, b> List<(a) b>] (List<a>) List<b>

  // Returns `.true!` if the test function holds for all elements.
  // Short-circuits on the first `.false!`.
  dec All : [<a: drop> List<a>, box [a] Bool] Bool

  // Returns `.true!` if the test function holds for at least one element.
  // Short-circuits on the first `.true!`.
  dec Any : [<a: drop> List<a>, box [a] Bool] Bool

  // Returns up to the requested number of elements from the start of a list.
  dec Take : [<a: drop> List<a>, Nat] List<a>

  // Drops the requested number of elements from the start of a list.
  dec Drop : [<a: drop> List<a>, Nat] List<a>

  // Takes elements from the start while the test function returns `.true!`.
  dec TakeWhile : [<a: share> List<a>, box [a] Bool] List<a>

  // Drops elements from the start while the test function returns `.true!`.
  dec DropWhile : [<a: share> List<a>, box [a] Bool] List<a>

  // Returns the smallest element, or `.none!` for an empty list.
  dec Min : [<a: data> List<a>] Option<a>

  // Returns the largest element, or `.none!` for an empty list.
  dec Max : [<a: data> List<a>] Option<a>

  // Returns the element with the smallest extracted data key, or `.none!` for an empty list.
  // Of elements with equal keys, the first one wins.
  dec MinBy : [<a: share> List<a>, <k: data> box [a] k] Option<a>

  // Returns the element with the largest extracted data key, or `.none!` for an empty list.
  // Of elements with equal keys, the first one wins.
  dec MaxBy : [<a: share> List<a>, <k: data> box [a] k] Option<a>

  // Sorts a list in ascending data order. Equal keys keep their original order.
  dec Sort : [<a: data> List<a>] List<a>

  // Sorts a list in descending data order. Equal keys keep their original order.
  dec SortDesc : [<a: data> List<a>] List<a>

  // Sorts a non-linear list by an extracted data key.
  dec SortBy : [<a: share> List<a>, <k: data> box [a] k] List<a>

  // Sorts a non-linear list by an extracted data key in descending order.
  dec SortDescBy : [<a: share> List<a>, <k: data> box [a] k] List<a>

  // Sorts a linear list by a function that returns both the key and the item.
  dec SortLinearBy : [<a> List<a>, <k: data> box [a] (k) a] List<a>

  // Sorts a linear list by a key in descending order.
  dec SortLinearDescBy : [<a> List<a>, <k: data> box [a] (k) a] List<a>

  // Calculates the sum of all elements in a list.
  dec Sum : [<a: number> List<a>] a

  // Nondeterministically merges lists into a single list. The order of elements is determined by readiness. Items of a single
  // list are yielded in order, but items from different lists may be interleaved depending on which list is ready to yield next.
  //
  // This is an implementation of a fan-in pattern, where a single consumer receives items from multiple producers.
  dec Merge : [<a> List<List<a>>] List<a>
}

def Builder = [type a]
  let append: [List<a>] List<a> = [xs] xs
  in begin case {
    .add(x) => let append = [xs: List<a>] append(.item(x) xs) in loop,
    .build* => append(.end!),
  }

def Map = [<a> list, <b> f] list.begin.case {
  .end! => .end!
  .item(v) list => .item(f(v)) list.loop,
}

def FlatMap = [<a> list, <b> f] list.begin.case {
  .end! => .end!,
  .item(v) list => f(v).begin@flat.case {
    .end! => list.loop,
    .item(v) flat => .item(v) flat.loop@flat,
  },
}

def FilterMap = [<a> list, <b> f] list.begin.case {
  .end! => .end!,
  .item(v) list => f(v).case {
    .some v => .item(v) list.loop,
    .none! => list.loop,
  },
}

def Filter = [<a: share> list, f] list.begin.case {
  .end! => .end!,
  .item(v) list => f(v).case {
    .true! => .item(v) list.loop,
    .false! => list.loop,
  },
}

def Partition = [<a: share> list, predicate] list.begin.case {
  .end! => (.end!) .end!,
  .item(v) list => do {
    let (yes) no = list.loop
  } in if {
    predicate(v) => (.item(v) yes) no,
    else => (yes) .item(v) no,
  },
}

def PartitionLinear = [<a> list, predicate] list.begin.case {
  .end! => (.end!) .end!,
  .item(v) list => do {
    let (matches) v = predicate(v)
    let (yes) no = list.loop
  } in matches.case {
    .true! => (.item(v) yes) no,
    .false! => (yes) .item(v) no,
  },
}

def Find = [<a: share> list, f] list.begin.case {
  .end! => .none!,
  .item(v) list => f(v).case {
    .true! => .some v,
    .false! => list.loop,
  },
}

def Contains = [<a: data> list, value] list->Any(box [v] v == value)

def Count = [<a> list, predicate]
  let count = 0
  in list.begin.case {
    .end! => count,
    .item(v) list => do {
      if predicate(v) => { count += 1 }
    } in list.loop,
  }

def ForEach = [<r> result, <a> list, f] list.begin.case {
  .end! => result,
  .item(v) list => do { result->f(v) } in list.loop,
}

def Length = [<a: drop> list]
  let len = 0 in
  list.begin.case {
    .end! => len,
    .item(_) list => do { len += 1 } in list.loop,
  }

def First = [<a: drop> list] list.case {
  .end! => .none!,
  .item(v) _ => .some v,
}

def Last = [<a: drop> list]
  let last: Option<a> = .none!
  in list.begin.case {
    .end! => last,
    .item(v) list => do {
      let last = .some v
    } in list.loop,
  }

def Concat = [<a> lists] chan yield {
  lists.begin.case {
    .item(list) => {
      yield->Copy(list)
      lists.loop
    }
    .end! => {
      yield.end!
    }
  }
}

def Reverse = [<a> list]
  let reversed: List<a> = .end! in
  list.begin.case {
    .end! => reversed,
    .item(v) list => do {
      let reversed = .item(v) reversed
    } in list.loop,
  }

def Dedup = [<a: data> list]
  let seen = CoreMap.New(type a, type !)
  in list.begin.case {
    .end! => .end!,
    .item(v) list => do {
      seen.entry(v)[found]
      seen.put(!)
    } in if {
      found is .some! => list.loop,
      else => .item(v) list.loop,
    },
  }

def Copy = [<a> dst, src] do {
  src.begin.case {
    .end! => {},
    .item(v) src => {
      dst.item(v)
      src.loop
    },
  }
} in dst

def Enumerate = [<a> list]
  let index = 0 in
  list.begin.case {
    .end! => .end!,
    .item(v) list => do {
      let current = index
      index += 1
    } in .item((current) v) list.loop,
  }

def Zip = [<a: drop> list1, <b: drop> list2] chan yield {
  list1.begin.case {
    .end! => { yield.end! },
    .item(v1) list1 => {
      list2.case {
        .end! => { yield.end! },
        .item(v2) list2 => {
          yield.item((v1) v2)
          list1.loop
        },
      }
    },
  }
}

def Unzip = [<a, b> list] list.begin.case {
  .end! => (.end!) .end!,
  .item((x) y) xys => do {
    let (xs) ys = xys.loop
  } in (.item(x) xs) .item(y) ys
}

def All = [<a: drop> list, f]
  list.begin.case {
    .end! => .true!,
    .item(v) list => f(v).case {
      .true! => list.loop,
      .false! => .false!,
    },
  }

def Any = [<a: drop> list, f] {not list->All(box [v] {not f(v)})}

def Take = [<a: drop> list, n]
  Nat.Repeat(n).begin.case {
    .end! => .end!,
    .step next => list.case {
      .end! => .end!
      .item(v) list => .item(v) next.loop,
    }
  }

def Drop = [<a: drop> list, n]
  Nat.Repeat(n).begin.case {
    .end! => list,
    .step next => list.case {
      .end! => .end!,
      .item(_) list => next.loop,
    },
  }

def TakeWhile = [<a: share> list, f] list.begin.case {
  .end! => .end!,
  .item(v) list => f(v).case {
    .true! => .item(v) list.loop,
    .false! => .end!,
  },
}

def DropWhile = [<a: share> list, f] list.begin.case {
  .end! => .end!,
  .item(v) list => f(v).case {
    .true! => list.loop,
    .false! => .item(v) list,
  },
}

def Min = [<a: data> list] list.case {
  .end! => .none!,
  .item(best) list => .some {
    list.begin.case {
      .end! => best,
      .item(v) list => do {
        if v < best => { let best = v }
      } in list.loop,
    }
  },
}

def Max = [<a: data> list] list.case {
  .end! => .none!,
  .item(best) list => .some {
    list.begin.case {
      .end! => best,
      .item(v) list => do {
        if v > best => { let best = v }
      } in list.loop,
    }
  },
}

def MinBy = [<a: share> list, <k: data> key] list.case {
  .end! => .none!,
  .item(best) list => .some {
    let bestKey = key(best)
    in list.begin.case {
      .end! => best,
      .item(v) list => do {
        let k = key(v)
        if k < bestKey => {
          let best = v
          let bestKey = k
        }
      } in list.loop,
    }
  },
}

def MaxBy = [<a: share> list, <k: data> key] list.case {
  .end! => .none!,
  .item(best) list => .some {
    let bestKey = key(best)
    in list.begin.case {
      .end! => best,
      .item(v) list => do {
        let k = key(v)
        if k > bestKey => {
          let best = v
          let bestKey = k
        }
      } in list.loop,
    }
  },
}

def Sort = external

def SortDesc = external

def SortBy = external

def SortDescBy = external

def SortLinearBy = external

def SortLinearDescBy = external

def Sum = [<a: number> list] do {
  let sum = Number.Zero(type a)
} in list.begin.case {
  .end! => sum,
  .item(x) xs => do { sum += x } in xs.loop,
}

def Merge = [<a> lists] do {
  let fan : ListFan<a> = lists.begin.case {
    .end! => .end!,
    .item(list) lists => .spawn(list) lists.loop,
  }
} in poll(fan) {
  client => client.case {
    .end! => submit(),
    .spawn(left) right => submit(left, right),
    .item(x) fan => .item(x) submit(fan),
  }
  else => .end!,
}

type ListFan<a> = recursive either {
  .end!,
  .spawn(self) self,
  .item(a) self,
}
